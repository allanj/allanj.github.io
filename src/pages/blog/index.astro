---
import { getCollection } from 'astro:content';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { fmtDate, postUrl, readingTime } from '../../lib/posts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---

<Base title="Writing" description="Notes on reasoning, papers, conferences, and the occasional infrastructure war story.">
  <header class="page-head grid-bg">
    <div class="wrap">
      <p class="eyebrow"><span class="idx">~/</span>writing</p>
      <h1>Notes &amp; posts</h1>
      <p class="lede">
        Paper walkthroughs, conference notes, writing practice, and the occasional infrastructure war story.
      </p>
      <p class="actions">
        <a class="btn" href="/rss.xml"><Icon name="rss" /> RSS feed</a>
        <span class="mono count">{posts.length} posts</span>
      </p>
    </div>
  </header>

  <section class="wrap list">
    {
      [...byYear].map(([year, items]) => (
        <div class="year-block">
          <h2 class="year mono">{year}</h2>
          <ul>
            {items.map((p) => (
              <li>
                <a href={postUrl(p)} class="row" data-reveal>
                  <time class="mono">{fmtDate(p.data.pubDate).slice(5)}</time>
                  <div class="main">
                    <h3>{p.data.title}</h3>
                    <p>{p.data.description}</p>
                    <p class="tags mono">
                      {p.data.tags.map((t) => (
                        <span>#{t}</span>
                      ))}
                      <span class="rt">{readingTime(p.body)} min read</span>
                    </p>
                  </div>
                  <Icon name="arrow-right" size={18} class="arrow" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 96px) clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  h1 {
    margin: 14px 0 16px;
    font-size: clamp(40px, 6.4vw, 72px);
    letter-spacing: -0.05em;
  }
  .lede {
    max-width: 56ch;
    color: var(--text-2);
    font-size: 18px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }
  .count {
    font-size: 12px;
    color: var(--muted);
  }
  .list {
    padding-block: clamp(32px, 6vw, 72px) clamp(56px, 8vw, 104px);
  }
  .year-block {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
    padding-block: 8px;
  }
  .year-block + .year-block {
    margin-top: 32px;
  }
  .year {
    position: sticky;
    top: 88px;
    align-self: start;
    padding-top: 22px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 24px;
    gap: 20px;
    padding: 22px 8px;
    border-bottom: 1px solid var(--line);
    transition: background 0.25s, padding 0.3s var(--ease);
  }
  .row time {
    padding-top: 5px;
    font-size: 12px;
    color: var(--muted);
  }
  .main h3 {
    font-size: 20px;
    font-weight: 550;
    letter-spacing: -0.02em;
  }
  .main p {
    margin-top: 6px;
    color: var(--text-2);
    font-size: 15px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 11.5px;
    color: var(--muted) !important;
  }
  .rt {
    color: var(--faint);
  }
  .row :global(.arrow) {
    margin-top: 5px;
    color: var(--faint);
    transition: transform 0.3s var(--ease), color 0.2s;
  }
  .row:hover {
    background: var(--surface);
    padding-inline: 16px;
  }
  .row:hover h3 {
    color: var(--accent);
  }
  .row:hover :global(.arrow) {
    color: var(--accent);
    transform: translateX(4px);
  }
  @media (max-width: 720px) {
    .year-block {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .year {
      position: static;
      padding-top: 0;
    }
    .row {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 12px;
      padding-inline: 0;
    }
    .row :global(.arrow) {
      display: none;
    }
  }
</style>
