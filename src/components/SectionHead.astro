---
interface Props {
  idx: string;
  label: string;
  title: string;
  as?: 'h1' | 'h2';
}
const { idx, label, title, as: Tag = 'h2' } = Astro.props;
---

<header class="shead">
  <p class="eyebrow"><span class="idx">{idx}</span><span class="slash">/</span>{label}</p>
  <div class="row">
    <Tag class="t">{title}</Tag>
    <slot />
  </div>
</header>

<style>
  .shead {
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .slash {
    color: var(--faint);
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 12px;
  }
  .t {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 550;
    letter-spacing: -0.04em;
  }
</style>
