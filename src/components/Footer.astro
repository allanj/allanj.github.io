---
import { execSync } from 'node:child_process';
import { nav, site, socials } from '../data/site';
import Icon from './Icon.astro';

let sha = process.env.GITHUB_SHA?.slice(0, 7) ?? '';
if (!sha) {
  try {
    sha = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
  } catch {
    sha = 'local';
  }
}
const built = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cta">
      <p class="eyebrow"><span class="pulse"></span> open to collaborations</p>
      <h2>
        Let’s talk about <span class="serif">agents</span>, <span class="serif">RL</span>, or <span class="serif">AI for science</span>.
      </h2>
      <div class="cta-actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}><Icon name="email" /> {site.email}</a>
        <a class="btn" href="https://scholar.google.com/citations?user=u68TA6oAAAAJ" target="_blank" rel="noopener"
          ><Icon name="scholar" /> Scholar</a
        >
      </div>
    </div>

    <div class="cols">
      <div>
        <p class="h mono">navigate</p>
        <ul>
          <li><a class="link" href="/">Home</a></li>
          {
            nav.map((n) => (
              <li>
                <a class="link" href={n.href}>
                  {n.label}
                </a>
              </li>
            ))
          }
          <li><a class="link" href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div>
        <p class="h mono">elsewhere</p>
        <ul>
          {
            socials
              .filter((s) => s.id !== 'email')
              .map((s) => (
                <li>
                  <a class="link" href={s.href} target="_blank" rel="noopener me">
                    {s.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
      <div class="status mono">
        <p><span class="k">loc</span> {site.location} · <time data-clock data-tz={site.timezone}>SGT</time></p>
        <p><span class="k">build</span> {sha} · {built}</p>
        <p><span class="k">stack</span> astro · geist · jetbrains mono</p>
      </div>
    </div>

    <div class="legal mono">
      <span>© {year} Zhanming Jie</span>
      <span>
        <kbd data-mod>⌘</kbd><kbd>K</kbd> to jump anywhere
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(56px, 8vw, 96px) 28px;
    background: linear-gradient(to bottom, var(--bg), var(--bg-raise));
  }
  .cta h2 {
    max-width: 18ch;
    margin: 18px 0 28px;
    font-size: clamp(30px, 5.2vw, 56px);
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .cta h2 .serif {
    color: var(--accent);
    font-size: 1.08em;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 1.6fr);
    gap: 32px;
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .h {
    margin-bottom: 12px;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 14px;
  }
  ul .link {
    color: var(--text-2);
  }
  .status {
    display: grid;
    gap: 6px;
    align-content: start;
    font-size: 12px;
    color: var(--muted);
  }
  .status .k {
    display: inline-block;
    width: 48px;
    color: var(--faint);
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
    font-size: 12px;
    color: var(--faint);
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .status {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: el.dataset.tz,
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => (el.textContent = `${fmt.format(new Date())} SGT`);
    tick();
    setInterval(tick, 15_000);
  }
</script>
