---
import Icon from './Icon.astro';

export type PaletteItem = {
  group: 'Pages' | 'Sections' | 'Papers' | 'Writing' | 'Links' | 'Actions';
  title: string;
  hint?: string;
  href?: string;
  action?: 'theme' | 'copy-email' | 'copy-url';
  keywords?: string;
  external?: boolean;
};

interface Props {
  items: PaletteItem[];
}
const { items } = Astro.props;
---

<dialog class="palette" data-palette aria-label="Search and jump">
  <div class="panel">
    <div class="input-row">
      <Icon name="search" size={16} />
      <input
        type="text"
        placeholder="Search pages, papers, posts…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search"
        aria-controls="palette-list"
        role="combobox"
        aria-expanded="true"
        data-palette-input
      />
      <kbd>esc</kbd>
    </div>
    <ul id="palette-list" class="list" role="listbox" data-palette-list></ul>
    <div class="foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span class="count" data-palette-count></span>
    </div>
  </div>
</dialog>

<script type="application/json" id="palette-data" set:html={JSON.stringify(items)} />

<style>
  .palette {
    width: min(640px, calc(100vw - 24px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(255 255 255 / 0.02) inset;
    overflow: hidden;
  }
  .palette[open] {
    animation: pop 0.18s var(--ease);
  }
  .palette::backdrop {
    background: rgb(4 5 7 / 0.6);
    backdrop-filter: blur(4px);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .input-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .input-row input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: 400 16px/1.4 var(--font-sans);
  }
  .input-row input::placeholder {
    color: var(--faint);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 6px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .list :global(.group) {
    padding: 10px 10px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .list :global(.opt) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border-radius: 8px;
    cursor: pointer;
    scroll-margin: 6px;
  }
  .list :global(.opt .t) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
  }
  .list :global(.opt .h) {
    flex: none;
    max-width: 40%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .list :global(.opt .arrow) {
    color: var(--accent);
    opacity: 0;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .list :global(.opt[aria-selected='true']) {
    background: var(--surface-2);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .list :global(.opt[aria-selected='true'] .arrow) {
    opacity: 1;
  }
  .list :global(.empty) {
    padding: 28px 12px;
    text-align: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .foot {
    display: flex;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 11.5px;
  }
  .foot span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .foot .count {
    margin-left: auto;
  }
  @media (max-width: 560px) {
    .palette {
      margin-top: 72px;
    }
    .foot span:not(.count) {
      display: none;
    }
  }
</style>

<script>
  type Item = {
    group: string;
    title: string;
    hint?: string;
    href?: string;
    action?: string;
    keywords?: string;
    external?: boolean;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-palette-list]')!;
  const count = dialog.querySelector<HTMLElement>('[data-palette-count]')!;
  const items: Item[] = JSON.parse(document.getElementById('palette-data')!.textContent || '[]');
  const order = ['Pages', 'Sections', 'Actions', 'Papers', 'Writing', 'Links'];

  let results: Item[] = [];
  let active = 0;

  const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');

  function score(item: Item, terms: string[]) {
    const title = norm(item.title);
    const hay = norm(`${item.title} ${item.hint ?? ''} ${item.keywords ?? ''} ${item.group}`);
    let s = 0;
    for (const t of terms) {
      if (!hay.includes(t)) return -1;
      s += title.startsWith(t) ? 6 : title.includes(t) ? 3 : 1;
    }
    return s;
  }

  function render() {
    const q = norm(input.value.trim());
    const terms = q.split(/\s+/).filter(Boolean);
    if (!terms.length) {
      results = items.filter((i) => i.group !== 'Papers' || i.keywords?.includes('featured'));
    } else {
      results = items
        .map((i) => [i, score(i, terms)] as const)
        .filter(([, s]) => s >= 0)
        .sort((a, b) => b[1] - a[1])
        .map(([i]) => i);
    }
    results.sort((a, b) => order.indexOf(a.group) - order.indexOf(b.group));
    active = 0;
    list.innerHTML = '';
    if (!results.length) {
      list.innerHTML = `<li class="empty">no goals match “${input.value.replace(/[<>&]/g, '')}”</li>`;
      count.textContent = '0 results';
      return;
    }
    let lastGroup = '';
    results.forEach((item, idx) => {
      if (item.group !== lastGroup) {
        const g = document.createElement('li');
        g.className = 'group';
        g.setAttribute('role', 'presentation');
        g.textContent = item.group;
        list.appendChild(g);
        lastGroup = item.group;
      }
      const li = document.createElement('li');
      li.className = 'opt';
      li.id = `pal-opt-${idx}`;
      li.setAttribute('role', 'option');
      li.dataset.idx = String(idx);
      const t = document.createElement('span');
      t.className = 't';
      t.textContent = item.title;
      li.appendChild(t);
      if (item.hint) {
        const h = document.createElement('span');
        h.className = 'h';
        h.textContent = item.hint;
        li.appendChild(h);
      }
      const a = document.createElement('span');
      a.className = 'arrow';
      a.textContent = item.external ? '↗' : '↵';
      li.appendChild(a);
      li.addEventListener('mousemove', () => select(idx, false));
      li.addEventListener('click', () => run(item));
      list.appendChild(li);
    });
    count.textContent = `${results.length} result${results.length === 1 ? '' : 's'}`;
    select(0, false);
  }

  function select(idx: number, scroll = true) {
    active = (idx + results.length) % results.length;
    list.querySelectorAll('.opt').forEach((el) => el.setAttribute('aria-selected', 'false'));
    const el = list.querySelector<HTMLElement>(`#pal-opt-${active}`);
    if (el) {
      el.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', el.id);
      if (scroll) el.scrollIntoView({ block: 'nearest' });
    }
  }

  async function run(item: Item) {
    if (item.action === 'theme') {
      close();
      document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
      return;
    }
    if (item.action === 'copy-email' || item.action === 'copy-url') {
      const text = item.action === 'copy-email' ? (item.hint ?? '') : location.origin;
      try {
        await navigator.clipboard.writeText(text);
        input.value = '';
        input.placeholder = `copied ${text} ✓`;
      } catch {}
      render();
      return;
    }
    if (item.href) {
      close();
      if (item.external) window.open(item.href, '_blank', 'noopener');
      else location.href = item.href;
    }
  }

  function open() {
    if (dialog.open) return;
    input.value = '';
    input.placeholder = 'Search pages, papers, posts…';
    render();
    dialog.showModal();
    input.focus();
  }
  function close() {
    if (dialog.open) dialog.close();
  }

  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      select(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      select(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const item = results[active];
      if (item) run(item);
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));
  window.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const typing = target.closest('input, textarea, [contenteditable="true"]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    } else if (e.key === '/' && !typing && !dialog.open) {
      e.preventDefault();
      open();
    }
  });
</script>
